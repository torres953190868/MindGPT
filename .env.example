AI_PROVIDER=deepseek

# Admin console. Comma-separate the Supabase Auth emails that can access /admin.
BRANCHMIND_ADMIN_EMAILS=
# Local-only escape hatch for /admin while developing without Supabase Auth.
BRANCHMIND_ENABLE_LOCAL_ADMIN=false

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional comma-separated allowlist override.
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Set AI_PROVIDER=opencode-go to use OpenCode Go.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=glm-5.1
# Optional provider-specific timeout. Kimi/large models often need longer than 30s.
OPENCODE_GO_TIMEOUT_MS=90000
# OpenCode Go chat-completions models shown in the model menu.
OPENCODE_GO_ALLOWED_MODELS=glm-5.1,qwen3.6-plus,mimo-v2.5-pro,deepseek-v4-pro,kimi-k2.6

# Used to build Supabase Auth email/OAuth callback URLs.
APP_ORIGIN=http://localhost:3002

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's newer dashboard may show this as a publishable key.
# Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth should enable email/password sign-ups, email confirmation, password
# recovery, and Google if you want the Google button. Add these redirect URLs in
# Supabase Auth settings for local and production hosts:
#   http://localhost:3002/auth/callback
#   https://your-domain.example/auth/callback

# auto uses Supabase when configured, otherwise file storage outside production.
# production always requires Supabase configuration.
BRANCHMIND_PROJECTS_BACKEND=auto

# PDF Reader + RAG
# auto uses Supabase when configured, otherwise file storage outside production.
BRANCHMIND_RAG_BACKEND=auto
MAX_PDF_SIZE_MB=50

# PDF embeddings. Providers: dashscope, gemini.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Alibaba Cloud Model Studio / DashScope embeddings.
DASHSCOPE_API_KEY=

# Google Gemini embeddings. Set EMBEDDING_PROVIDER=gemini to use these.
# EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_API_KEY=
# Optional Gemini-specific overrides.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=1024
# Optional provider retry tuning for transient 429 / resource exhausted errors.
# EMBEDDING_RETRY_ATTEMPTS=5
# EMBEDDING_RETRY_DELAY_MS=250
# EMBEDDING_RETRY_MAX_DELAY_MS=8000

# RAG answer generation reuses the existing chat-completions providers.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
