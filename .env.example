AI_PROVIDER=deepseek

# Deterministic mock AI replies for local development, CI, and E2E only.
# Never enable in production.
AI_MOCK_MODE=false
# Optional global chat-completions timeout fallback in ms (defaults to 30000).
# Per-provider overrides such as DEEPSEEK_TIMEOUT_MS take precedence.
AI_PROVIDER_TIMEOUT_MS=30000

# Admin console. Comma-separate the Supabase Auth emails that can access /admin.
BRANCHMIND_ADMIN_EMAILS=
# Local-only escape hatch for /admin while developing without Supabase Auth.
BRANCHMIND_ENABLE_LOCAL_ADMIN=false

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional comma-separated allowlist override.
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Set AI_PROVIDER=gemini to use Gemini through Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_ALLOWED_MODELS=gemini-3.5-flash

# Used to build Supabase Auth OAuth callback URLs.
APP_ORIGIN=http://localhost:3002
# Comma-separated origins trusted for mutating API requests. APP_ORIGIN is
# always trusted; add ALLOWED_ORIGINS/TRUSTED_ORIGINS for extra hosts such as
# preview deployments. Production should configure at least one of these.
ALLOWED_ORIGINS=
TRUSTED_ORIGINS=

# Public support inbox shown on the privacy page as the contact channel for
# questions and deletion requests. Leave empty to keep the generic
# "operator or project maintainer" wording instead.
NEXT_PUBLIC_SUPPORT_EMAIL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's newer dashboard may show this as a publishable key.
# Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth should enable email/password sign-in. BranchMind creates
# account-name/password users server-side with SUPABASE_SERVICE_ROLE_KEY and
# marks them confirmed immediately; public email sign-up, email verification,
# magic links, and email password recovery are not used. Keep Google enabled if
# you want the Google button. Add these redirect URLs in Supabase Auth settings
# for local and production hosts:
#   http://localhost:3002/auth/callback
#   https://your-domain.example/auth/callback
# Optional override for the Supabase rate-limit table name.
RATE_LIMIT_TABLE=rate_limits

# auto uses Supabase when configured, otherwise file storage outside production.
# production always requires Supabase configuration.
BRANCHMIND_PROJECTS_BACKEND=auto
# Smoke tests only: permits file-backed storage in production.
# Never enable in real production.
BRANCHMIND_ALLOW_FILE_STORE_IN_PRODUCTION=false

# PDF Reader + RAG
# auto uses Supabase when configured, otherwise file storage outside production.
BRANCHMIND_RAG_BACKEND=auto
# inline processes PDF jobs in-process; queue uses Vercel Queues.
# Empty falls back to inline in next dev and queue elsewhere. Production must use queue.
BRANCHMIND_RAG_QUEUE_MODE=
MAX_PDF_SIZE_MB=50

# PDF embeddings. Providers: dashscope, gemini.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Alibaba Cloud Model Studio / DashScope embeddings.
DASHSCOPE_API_KEY=
# Optional endpoint override; defaults to the Alibaba Cloud OpenAI-compatible URL.
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

# Google Gemini embeddings. Set EMBEDDING_PROVIDER=gemini to use these.
# EMBEDDING_MODEL=gemini-embedding-2
# Reuses GEMINI_API_KEY above.
# Optional Gemini-specific overrides.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=1024
# Optional provider retry tuning for transient 429 / resource exhausted errors.
# EMBEDDING_RETRY_ATTEMPTS=5
# EMBEDDING_RETRY_DELAY_MS=250
# EMBEDDING_RETRY_MAX_DELAY_MS=8000

# RAG answer generation reuses the existing chat-completions providers.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# Dual-agent learning system (rolled out disabled; both default to off).
# ENABLE_CURRICULUM_AGENT=false
# ENABLE_TUTOR_AGENT=false
# Monthly curriculum generation quotas per plan (free/pro/max). null/unset =
# unlimited. Defaults: free=3, pro=30, max=unlimited.
# FREE_PLAN_MONTHLY_CURRICULUM_GENERATIONS=3
# PRO_PLAN_MONTHLY_CURRICULUM_GENERATIONS=30
# MAX_PLAN_MONTHLY_CURRICULUM_GENERATIONS=
# Curriculum, learning and agent-run storage share ONE backend switch.
# auto uses Supabase when configured, otherwise file storage outside
# production (data/branchmind-curriculum.json + data/branchmind-agent-runs.json).
# BRANCHMIND_CURRICULUM_BACKEND=auto
# inline runs resumed curriculum builds in-process; queue uses Vercel Queues.
# Empty falls back to inline in next dev and queue elsewhere. Production must use queue.
# BRANCHMIND_CURRICULUM_QUEUE_MODE=
# Web search provider for the research agent. Empty = disabled (default);
# mock = deterministic fake results for tests/CI/E2E; tavily = real web
# search via the Tavily API (requires TAVILY_API_KEY).
# WEB_SEARCH_PROVIDER=
# API key for the Tavily search provider (only when WEB_SEARCH_PROVIDER=tavily).
# TAVILY_API_KEY=
# Override the Tavily search endpoint (testing/staging only).
# TAVILY_API_URL=
# Optional explicit fallback provider after a Tavily outage: disabled (default)
# or mock (only for local/test environments).
# WEB_SEARCH_FALLBACK_PROVIDER=disabled
# Optional model pricing for cost telemetry. Keys may be provider/model,
# model, provider or default; values are USD per million input/output tokens.
# BRANCHMIND_LLM_COST_RATES_JSON='{"deepseek/deepseek-v4-flash":{"inputPerMillionTokens":0,"outputPerMillionTokens":0}}'
# Retention windows for the explicit, confirmed cleanup job.
# BRANCHMIND_TRACE_RETENTION_DAYS=30
# BRANCHMIND_SOURCE_CHUNK_RETENTION_DAYS=180
# BRANCHMIND_ASSESSMENT_RETENTION_DAYS=365
# Safe web fetcher for the research agent. Empty/http = real SSRF-safe
# fetching (default); mock = deterministic fake pages for tests/CI/E2E.
# WEB_FETCHER=
