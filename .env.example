AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional comma-separated allowlist override.
DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-chat,deepseek-reasoner

# Set AI_PROVIDER=opencode-go to use OpenCode Go.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
# OpenCode Go chat-completions models. MiniMax Go models use /messages and are not used by this app yet.
OPENCODE_GO_ALLOWED_MODELS=glm-5.1,glm-5,kimi-k2.5,kimi-k2.6,deepseek-v4-pro,deepseek-v4-flash,mimo-v2-pro,mimo-v2-omni,mimo-v2.5-pro,mimo-v2.5,qwen3.6-plus,qwen3.5-plus

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# auto uses Supabase when configured, otherwise file storage outside production.
# production always requires Supabase configuration.
BRANCHMIND_PROJECTS_BACKEND=auto
